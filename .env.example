# ============================================
# CLAWDMARKET WALLET ADDRESSES
# ============================================
# Set these in Vercel: Settings → Environment Variables → Production
# Marketplace checkout is currently sandbox-ledger only. The external values
# below are reserved for platform-owned API charges and future payout work.

# --- EVM (Ethereum Virtual Machine) ---
# Reserved for future marketplace payout/refund integration. Setting these
# values does not enable ERC-20 marketplace checkout.
TREASURY_ADDRESS=
NEXT_PUBLIC_TREASURY_ADDRESS=
DEV_FEE_WALLET_ADDRESS=
EVM_RPC_URL=

# --- MPP / Tempo (pathUSD) ---
# Used only for platform-owned API usage through MPP on Tempo (chain ID 4217).
# It does not enable buyer-to-seller marketplace settlement.
MPP_RECIPIENT_ADDRESS=
# Secret key for MPP server verification (generate: openssl rand -hex 32)
MPP_SECRET_KEY=

# ============================================
# PAYMENT RAIL CONFIGURATION
# ============================================

# CoinGecko API (optional — free tier works without key, Pro for higher limits)
COINGECKO_API_KEY=

# WalletConnect Project ID (free at cloud.walletconnect.com)
NEXT_PUBLIC_WC_PROJECT_ID=

# ============================================
# DATABASE
# ============================================
TURSO_DATABASE_URL=
TURSO_AUTH_TOKEN=

# ============================================
# SECURITY
# ============================================
CRON_SECRET=
WEBHOOK_SECRET_KEY=
ADMIN_SECRET=
JWT_SECRET=
CHAT_ENCRYPTION_KEY=
ANALYTICS_SALT=
NEXT_PUBLIC_BASE_URL=http://localhost:3000

# Password reset email delivery (Resend). Tokens are only returned in local
# development; production requires these values to send the reset link.
RESEND_API_KEY=
PASSWORD_RESET_FROM_EMAIL=

# Optional production health check key. Set in Vercel Production to a disposable
# ClawdMarket agent api_key so /api/health/full can verify authenticated
# /api/agent/self-test end to end without exposing the secret.
CLAWDMARKET_SELF_TEST_API_KEY=

# Hard safety rails for purchases initiated with a registered-agent identity.
# Values are non-redeemable sandbox credits and are checked inside settlement.
CLAWDMARKET_AGENT_MAX_TRADE_CREDITS=50
CLAWDMARKET_AGENT_DAILY_SPEND_CREDITS=200

# Discord webhook for monitor cron alerts (first agent registration, hourly stats)
# Create at: Discord channel → Edit → Integrations → Webhooks → New Webhook → Copy URL
# Leave empty to disable alerts (cron will still run, just won't POST)
MONITOR_WEBHOOK_URL=
