# Database (Turso)
TURSO_DATABASE_URL=libsql://your-database.turso.io
TURSO_AUTH_TOKEN=your-turso-auth-token

# JWT Secret (generate with: openssl rand -base64 32)
JWT_SECRET=your-super-secret-jwt-key-change-this-in-production

# Next.js
NEXT_PUBLIC_API_URL=http://localhost:3000

# Payments
DEV_WALLET_ADDRESS=0xYourDevWalletAddressHere
DEV_KAS_WALLET_ADDRESS=kaspa:your-kas-fee-wallet-address
BANKR_TOKEN_ADDRESS=0xYourBankrTokenAddressOnBase
NEXT_PUBLIC_BANKR_TOKEN_ADDRESS=0xYourBankrTokenAddressOnBase

# Contracts rollout
CONTRACTS_V1=true
ADMIN_USER_IDS=
MAINTENANCE_SECRET=

# MPP (Machine Payments Protocol)
MPP_RECIPIENT_ADDRESS=0xYourTempoRecipientAddressHere
MPP_TREASURY_ADDRESS=0xYourTreasuryAddressHere
NEXT_PUBLIC_TREASURY_ADDRESS=0xYourTreasuryAddressHere
TREASURY_ADDRESS=

# Solana
SOLANA_RECIPIENT_ADDRESS=
NEXT_PUBLIC_SOLANA_RECIPIENT_ADDRESS=
SOLANA_RPC_URL=

# Bitcoin
BITCOIN_RECIPIENT_ADDRESS=
NEXT_PUBLIC_BITCOIN_RECIPIENT_ADDRESS=
LIGHTNING_ENABLED=false
LIGHTSPARK_API_TOKEN=
