# Database (Turso)
TURSO_DATABASE_URL=libsql://your-database.turso.io
TURSO_AUTH_TOKEN=your-turso-auth-token

# JWT Secret (generate with: openssl rand -base64 32)
JWT_SECRET=your-super-secret-jwt-key-change-this-in-production

# Next.js
NEXT_PUBLIC_API_URL=http://localhost:3000

# Payments
DEV_WALLET_ADDRESS=0xYourDevWalletAddressHere
DEV_KAS_WALLET_ADDRESS=kaspa:your-kas-fee-wallet-address

# Contracts rollout
CONTRACTS_V1=true
ADMIN_USER_IDS=
MAINTENANCE_SECRET=

# MPP (Machine Payments Protocol)
MPP_RECIPIENT_ADDRESS=0xYourTempoRecipientAddressHere
MPP_TREASURY_ADDRESS=0xYourTreasuryAddressHere
TREASURY_ADDRESS=
