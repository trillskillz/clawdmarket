# ============================================
# CLAWDMARKET WALLET ADDRESSES
# ============================================
# Set these in Vercel: Settings → Environment Variables → Production
# External marketplace rails are exposed only when every required value for a
# rail is configured and the settlement key matches its recipient address.

# --- EVM (Ethereum Virtual Machine) ---
# Treasury receives buyer deposits. The settlement key signs seller payouts and
# buyer refunds and MUST derive to TREASURY_ADDRESS.
TREASURY_ADDRESS=
NEXT_PUBLIC_TREASURY_ADDRESS=
# External fees remain in the collection wallet. If this optional declaration
# is set, it must match TREASURY_ADDRESS and MPP_RECIPIENT_ADDRESS.
DEV_FEE_WALLET_ADDRESS=
EVM_SETTLEMENT_PRIVATE_KEY=

# Per-chain RPCs used to verify deposits and broadcast settlement transfers.
# Configure each chain you advertise. EVM_RPC_URL_<chainId> overrides the
# generic fallback, for example EVM_RPC_URL_8453 for Base.
EVM_RPC_URL=
EVM_RPC_URL_1=
EVM_RPC_URL_10=
EVM_RPC_URL_137=
EVM_RPC_URL_8453=
EVM_RPC_URL_42161=

# Optional JSON override for accepted ERC-20 tokens. Each entry requires
# chainId, symbol, address, decimals, confirmations, and fixedUsdPrice. The app
# otherwise uses its built-in USDC allowlist on the supported networks.
# EVM_ACCEPTED_TOKENS=[{"chainId":8453,"symbol":"USDC","address":"0x...","decimals":6,"confirmations":12,"fixedUsdPrice":1}]
EVM_ACCEPTED_TOKENS=

# --- MPP / Tempo (pathUSD) ---
# Recipient receives pathUSD deposits for platform usage and marketplace trades.
# The settlement key above must derive to this same address.
MPP_RECIPIENT_ADDRESS=
# Secret key for MPP server verification; minimum 32 bytes
# (generate: openssl rand -base64 32)
# Use MPP_SECRET_KEY_CURRENT for rotation without deleting a write-only secret.
MPP_SECRET_KEY_CURRENT=
MPP_SECRET_KEY=
TEMPO_RPC_URL=

# ============================================
# PAYMENT RAIL CONFIGURATION
# ============================================

# Managed balance is opt-in. Set redeemable=true only when the deployment has
# operational deposit and withdrawal backing for that balance.
CLAWDMARKET_LEDGER_ENABLED=false
CLAWDMARKET_LEDGER_REDEEMABLE=false
# Emergency override for NEW marketplace payments. Requires a fresh Vercel
# deployment after changing it; existing verification/refunds remain available.
# The admin dashboard has a faster audited database-backed control.
CLAWDMARKET_NEW_PAYMENTS_PAUSED=false

# CoinGecko API (optional — free tier works without key, Pro for higher limits)
COINGECKO_API_KEY=

# WalletConnect Project ID (free at cloud.walletconnect.com)
NEXT_PUBLIC_WC_PROJECT_ID=

# ============================================
# DATABASE
# ============================================
TURSO_DATABASE_URL=
TURSO_AUTH_TOKEN=

# Vercel production enables strict readiness automatically. Set this to true on
# other production hosts so /api/health/ready requires remote DB, secrets, and
# at least one operational marketplace payment rail.
CLAWDMARKET_PRODUCTION_READINESS=false

# ============================================
# SECURITY
# ============================================
CRON_SECRET=
SETTLEMENT_STUCK_AFTER_MINUTES=15
WEBHOOK_SECRET_KEY=
# Stable server-only pepper for registered-agent API key digests. Rotating this
# invalidates HMAC-digested keys unless a staged dual-key migration is used.
AGENT_API_KEY_PEPPER=
ADMIN_SECRET=
JWT_SECRET=
CHAT_ENCRYPTION_KEY=
ANALYTICS_SALT=
NEXT_PUBLIC_BASE_URL=http://localhost:3000

# Password reset email delivery (Resend). Tokens are only returned in local
# development; production requires these values to send the reset link.
RESEND_API_KEY=
PASSWORD_RESET_FROM_EMAIL=

# Production health check key and bearer credential for /api/health/full. Store
# the same high-entropy value in the Vercel
# Production environment and the GitHub Actions repository secret. The deploy
# workflow synchronizes its non-selling release-monitor identity before aliasing.
CLAWDMARKET_SELF_TEST_API_KEY=

# Optional server-only origin for /api/health/full. The route otherwise uses
# VERCEL_URL in Vercel and a loopback origin in local development.
CLAWDMARKET_HEALTH_BASE_URL=

# Hard safety rails for purchases initiated with a registered-agent identity.
# USD values are checked inside settlement; account-driven purchases are exempt.
CLAWDMARKET_AGENT_MAX_TRADE_USD=50
CLAWDMARKET_AGENT_DAILY_SPEND_USD=200

# Discord webhook for monitor cron alerts (first agent registration, hourly stats)
# Create at: Discord channel → Edit → Integrations → Webhooks → New Webhook → Copy URL
# Leave empty to disable alerts (cron will still run, just won't POST)
MONITOR_WEBHOOK_URL=
# Optional managed reference-fleet presence runtime. Generate with
# `pnpm ops:reference-fleet -- --apply`; never commit the resulting JSON.
REFERENCE_FLEET_KEYS_JSON=
FLEET_OWNER_EMAIL=
FLEET_OWNER_PASSWORD=
