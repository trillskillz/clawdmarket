# ============================================
# CLAWDMARKET WALLET ADDRESSES
# ============================================
# Set these in Vercel: Settings → Environment Variables → Production
# All addresses below receive payments from agents and humans

# --- EVM (Ethereum Virtual Machine) ---
# Used for: ETH, USDC, USDT, MATIC, BNB, AVAX, ARB, OP, DAI, WBTC
# and any other ERC-20 token on any EVM-compatible chain
# Supported chains: Ethereum, Polygon, BNB Chain, Avalanche,
# Arbitrum, Optimism, Base, zkSync, Cronos, Fantom
TREASURY_ADDRESS=
NEXT_PUBLIC_TREASURY_ADDRESS=

# --- MPP / Tempo (pathUSD) ---
# Used for: Machine Payments Protocol on Tempo blockchain (chain ID 4217)
# Same EVM address as TREASURY_ADDRESS if you want one wallet for all EVM
MPP_RECIPIENT_ADDRESS=
# Secret key for MPP server verification (generate: openssl rand -hex 32)
MPP_SECRET_KEY=

# --- Base / x402 / BNKR ---
# Used for: x402 payments on Base chain via Bankr protocol
# Same EVM address as TREASURY_ADDRESS if you want one wallet for all EVM
BASE_RECIPIENT_ADDRESS=
NEXT_PUBLIC_BASE_RECIPIENT_ADDRESS=

# --- Solana ---
# Used for: SOL, USDC (SPL), USDT (SPL), and any Solana SPL token
# Format: base58 public key (e.g. 6yVHd...Q2fz7)
SOLANA_RECIPIENT_ADDRESS=
NEXT_PUBLIC_SOLANA_RECIPIENT_ADDRESS=

# --- Bitcoin ---
# Used for: on-chain BTC payments
# Supported formats: bech32 (bc1q...), P2SH (3...), Legacy (1...)
# Recommended: bech32 native SegWit (bc1q...) — lowest fees
BITCOIN_RECIPIENT_ADDRESS=
NEXT_PUBLIC_BITCOIN_RECIPIENT_ADDRESS=

# --- Kaspa ---
# Used for: KAS payments (Kaspa network)
# Format: kaspa:prefix address
KASPA_RECIPIENT_ADDRESS=
NEXT_PUBLIC_KASPA_RECIPIENT_ADDRESS=

# --- Litecoin ---
# Used for: LTC payments
# Format: L... or M... or ltc1... (bech32)
LITECOIN_RECIPIENT_ADDRESS=
NEXT_PUBLIC_LITECOIN_RECIPIENT_ADDRESS=

# --- Dogecoin ---
# Used for: DOGE payments
# Format: D... (starts with D)
DOGECOIN_RECIPIENT_ADDRESS=
NEXT_PUBLIC_DOGECOIN_RECIPIENT_ADDRESS=

# --- XRP ---
# Used for: XRP payments on Ripple network
# Format: r... (starts with r)
XRP_RECIPIENT_ADDRESS=
XRP_DESTINATION_TAG=
NEXT_PUBLIC_XRP_RECIPIENT_ADDRESS=
NEXT_PUBLIC_XRP_DESTINATION_TAG=

# --- Cardano ---
# Used for: ADA payments
# Format: addr1... (bech32)
CARDANO_RECIPIENT_ADDRESS=
NEXT_PUBLIC_CARDANO_RECIPIENT_ADDRESS=

# --- Polkadot ---
# Used for: DOT payments
# Format: 1... (SS58 format)
POLKADOT_RECIPIENT_ADDRESS=
NEXT_PUBLIC_POLKADOT_RECIPIENT_ADDRESS=

# --- Cosmos / ATOM ---
# Used for: ATOM and IBC token payments
# Format: cosmos1...
COSMOS_RECIPIENT_ADDRESS=
NEXT_PUBLIC_COSMOS_RECIPIENT_ADDRESS=

# --- Monero ---
# Used for: XMR private payments
# Format: 4... (primary) or 8... (subaddress)
MONERO_RECIPIENT_ADDRESS=
NEXT_PUBLIC_MONERO_RECIPIENT_ADDRESS=

# ============================================
# PAYMENT RAIL CONFIGURATION
# ============================================

# CoinGecko API (optional — free tier works without key, Pro for higher limits)
COINGECKO_API_KEY=

# WalletConnect Project ID (free at cloud.walletconnect.com)
NEXT_PUBLIC_WC_PROJECT_ID=

# Lightning Network (via Lightspark — optional)
LIGHTSPARK_API_TOKEN=
LIGHTNING_ENABLED=false

# Solana RPC (optional — defaults to mainnet-beta public)
SOLANA_RPC_URL=https://api.mainnet-beta.solana.com
NEXT_PUBLIC_SOLANA_RPC_URL=https://api.mainnet-beta.solana.com

# Bitcoin verification API (defaults to Blockstream, no key needed)
BITCOIN_EXPLORER_API=https://blockstream.info/api

# ============================================
# DATABASE
# ============================================
TURSO_DATABASE_URL=
TURSO_AUTH_TOKEN=

# ============================================
# SECURITY
# ============================================
CRON_SECRET=
WEBHOOK_SECRET_KEY=
ADMIN_SECRET=
JWT_SECRET=

# Optional production health check key. Set in Vercel Production to a disposable
# ClawdMarket agent api_key so /api/health/full can verify authenticated
# /api/agent/self-test end to end without exposing the secret.
CLAWDMARKET_SELF_TEST_API_KEY=

# Discord webhook for monitor cron alerts (first agent registration, hourly stats)
# Create at: Discord channel → Edit → Integrations → Webhooks → New Webhook → Copy URL
# Leave empty to disable alerts (cron will still run, just won't POST)
MONITOR_WEBHOOK_URL=
